---
import SiteLayout from '../layouts/SiteLayout.astro';

const horizons = [
  {
    number: '01',
    label: 'Now',
    stage: 'Stable 0.2.0',
    title: 'Earn daily-driver confidence.',
    summary: 'Make persistence intuitive, Omarchy desktop integration seamless, and upgrades boring on the platform Splinterm validates today.',
    outcomes: [
      'Clear Lair states and predictable save/pin/restore controls',
      'Exact Omarchy theme fidelity and desktop integration',
      'Validated local file-drop and clipboard image workflows',
      'Smooth install, live-upgrade, recovery, and diagnostics',
      'Tracked startup latency and memory footprint',
    ],
    signal: 'A new user can close windows freely, return to running work, and predict every destructive action without maintainer help.',
  },
  {
    number: '02',
    label: 'Next',
    stage: 'Supported 1.0',
    title: 'Define a real 1.0 support contract.',
    summary: 'Commit to explicit, tested guarantees around upgrades, schemas, and recovery—not just a feature checklist.',
    outcomes: [
      'Declared platform matrix and compatibility windows',
      'Tested upgrade, rollback, reset, and recovery runbooks',
      'Stable configuration, CLI, and JSON/NDJSON contracts',
      'Clear bug-report and security-disclosure processes',
      'Understandable resource limits and failure diagnostics',
    ],
    signal: '1.0 is a support contract you can rely on, not an arbitrary milestone for accumulating features.',
  },
  {
    number: '03',
    label: 'Later',
    stage: 'Connected workspace',
    title: 'Keep one workspace across local, remote, and tools.',
    summary: 'Make local windows, SSH hosts, headless daemons, and authorized agents feel like one coherent workflow.',
    outcomes: [
      'Polished remote SSH profiles and drop recovery',
      'Reference integration kits for scripts and MCP hosts',
      'Clear visual cues for human vs. automated activity',
      'Portable, declarative workspace definitions',
    ],
    signal: 'Still no daemon network listener, cloud account, hosted control plane, synced secrets, or simultaneous typing.',
  },
  {
    number: '04',
    label: 'Explore',
    stage: 'Broader Linux',
    title: 'Expand only where we can test continuously.',
    summary: 'Investigate new environments without turning curiosity into an unsupported promise.',
    outcomes: [
      'Broader NixOS and Home Manager deployment acceptance',
      'Additional Wayland compositors with test coverage',
      'Additional distro packages with clean service upgrades',
      'A carefully scoped extension model',
      'Selective compatibility driven by real terminal apps',
    ],
    signal: 'Every new platform needs real blocked users, automated testing, a clear boundary, and an honest trade-off.',
  },
];
---

<SiteLayout
  title="Roadmap — Splinterm"
  description="Where Splinterm is headed from stable 0.2.0 toward a supported 1.0 release."
>
  <section class="roadmap-hero shell-section" aria-labelledby="roadmap-title">
    <div class="roadmap-hero-copy">
      <p class="eyebrow"><span>Horizons, not deadlines</span> · Product roadmap</p>
      <h1 id="roadmap-title">From daily driver<br />to a <em>supported 1.0.</em></h1>
      <p>
        Splinterm 0.2.0 is stable on x86_64 Omarchy and Arch Linux. These horizons lay out what
        we're building toward next—outcomes and graduation bars rather than calendar dates or
        premature compatibility promises.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="#horizons">Explore the horizons <span aria-hidden="true">↓</span></a>
        <a class="button secondary" href="/docs/roadmap/">Read the detailed roadmap</a>
      </div>
    </div>
    <div class="roadmap-compass" aria-label="Current roadmap position">
      <span>Current position</span>
      <strong>Stable 0.2.0</strong>
      <div class="compass-line" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      <ol>
        <li class="active">Confidence</li>
        <li>Contract</li>
        <li>Continuity</li>
        <li>Expansion</li>
      </ol>
      <p>x86_64 · Omarchy / Arch · native Wayland</p>
    </div>
  </section>

  <section class="roadmap-north shell-section" aria-labelledby="north-star-title">
    <div class="section-index" aria-hidden="true">North star</div>
    <blockquote id="north-star-title">One place where your terminal work stays alive while windows, machines, and tools come and go.</blockquote>
    <p>
      Splinterm is built for humans first. Scoped automation makes it more capable, without turning
      it into an “AI terminal.” We only claim support for environments we actually test.
    </p>
  </section>

  <section id="horizons" class="public-horizons shell-section" aria-label="Product roadmap horizons">
    {horizons.map((horizon, index) => (
      <article class:list={['public-horizon', { current: index === 0, explore: index === 3 }]}>
        <div class="public-horizon-index">
          <span>{horizon.number}</span>
          <i aria-hidden="true"></i>
        </div>
        <header>
          <p>{horizon.label} <span>· {horizon.stage}</span></p>
          <h2>{horizon.title}</h2>
          <p class="horizon-summary">{horizon.summary}</p>
        </header>
        <div class="public-horizon-outcomes">
          <p>Target outcomes</p>
          <ul>
            {horizon.outcomes.map((outcome) => <li>{outcome}</li>)}
          </ul>
          <div class="public-horizon-signal"><span>{index === 3 ? 'Decision bar' : 'Graduation bar'}</span>{horizon.signal}</div>
        </div>
      </article>
    ))}
  </section>

  <section class="roadmap-boundaries shell-section" aria-labelledby="boundaries-title">
    <div>
      <p class="eyebrow">Deliberate non-goals</p>
      <h2 id="boundaries-title">What we’re intentionally not building.</h2>
    </div>
    <ul>
      <li>Reboot-transparent process checkpointing</li>
      <li>Arbitrary <code>foot.ini</code> compatibility</li>
      <li>Unrestricted agent or script access</li>
      <li>Collaborative simultaneous typing</li>
      <li>A hosted cloud control plane</li>
      <li>Distro claims without continuous testing</li>
    </ul>
  </section>

  <section class="roadmap-exit shell-section" aria-labelledby="roadmap-exit-title">
    <div>
      <p class="eyebrow">Dig deeper</p>
      <h2 id="roadmap-exit-title">Want the full rationale?</h2>
    </div>
    <div>
      <p>The roadmap docs cover the full reasoning behind each horizon, and Current status tracks exactly what works today.</p>
      <div class="hero-actions">
        <a class="button primary" href="/docs/roadmap/">Roadmap documentation</a>
        <a class="text-link" href="https://github.com/ministry-of-taste/splinterm/blob/main/docs/product-roadmap.md">Repository roadmap <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</SiteLayout>
