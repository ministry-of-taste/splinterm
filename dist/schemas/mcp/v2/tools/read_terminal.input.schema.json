{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splinterm.oldjobobo.com/schemas/mcp/v2/tools/read_terminal.input.schema.json",
  "title": "splinterm.read_terminal input",
  "allOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "splint_id"
      ],
      "properties": {
        "splint_id": {
          "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/uuid"
        },
        "format": {
          "enum": [
            "text",
            "cells"
          ],
          "default": "text",
          "description": "text: the screen as one plain-text string; wrapped rows are joined (not on the alternate screen) and trailing spaces dropped. cells: one object per cell with its display width."
        }
      }
    }
  ]
}
