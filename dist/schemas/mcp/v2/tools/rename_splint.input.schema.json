{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splinterm.oldjobobo.com/schemas/mcp/v2/tools/rename_splint.input.schema.json",
  "title": "splinterm.rename_splint input",
  "allOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "splint_id"
      ],
      "properties": {
        "splint_id": {
          "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/uuid"
        },
        "title": {
          "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/name"
        },
        "use_app_name": {
          "const": true,
          "description": "Instead of title: undo the rename, so windows show the running app's name."
        }
      }
    },
    {
      "oneOf": [
        {
          "required": [
            "title"
          ]
        },
        {
          "required": [
            "use_app_name"
          ]
        }
      ]
    }
  ]
}
