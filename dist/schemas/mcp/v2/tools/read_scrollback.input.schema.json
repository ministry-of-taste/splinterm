{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splinterm.oldjobobo.com/schemas/mcp/v2/tools/read_scrollback.input.schema.json",
  "title": "splinterm.read_scrollback input",
  "allOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "splint_id"
      ],
      "properties": {
        "splint_id": {
          "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/uuid"
        },
        "cursor": {
          "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/cursor"
        },
        "max_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "format": {
          "enum": [
            "text",
            "cells"
          ],
          "default": "text",
          "description": "text: the page as one plain-text string, one line per line. cells: one object per cell with its display width."
        }
      }
    }
  ]
}
