{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splinterm.oldjobobo.com/schemas/mcp/v2/tools/inspect_splint.output.schema.json",
  "title": "splinterm.inspect_splint successful output",
  "allOf": [
    {
      "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/success_envelope"
    },
    {
      "properties": {
        "tool": {
          "const": "splinterm.inspect_splint"
        },
        "content_trust": {
          "const": "untrusted_terminal_data"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "state"
          ],
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 1024
            },
            "state": {
              "enum": [
                "running",
                "exited",
                "restorable"
              ]
            },
            "agent_status": {
              "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/agent_status"
            },
            "foreground_app": {
              "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/foreground_app"
            }
          }
        },
        "truncated": {
          "const": false
        },
        "resource": {
          "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/logical_splint_resource"
        }
      }
    }
  ]
}
