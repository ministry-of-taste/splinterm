{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splinterm.oldjobobo.com/schemas/mcp/v2/tools/input.input.schema.json",
  "title": "splinterm.input input",
  "allOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "splint_id",
        "incarnation"
      ],
      "properties": {
        "splint_id": {
          "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/uuid"
        },
        "incarnation": {
          "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/positive_integer"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "keys": {
          "description": "Keys pressed after text, in order. Use [\"enter\"] to submit; a line break in text is LF, not Enter.",
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "enum": [
              "enter",
              "tab",
              "shift-tab",
              "escape",
              "backspace",
              "ctrl-a",
              "ctrl-b",
              "ctrl-c",
              "ctrl-d",
              "ctrl-e",
              "ctrl-f",
              "ctrl-g",
              "ctrl-h",
              "ctrl-i",
              "ctrl-j",
              "ctrl-k",
              "ctrl-l",
              "ctrl-m",
              "ctrl-n",
              "ctrl-o",
              "ctrl-p",
              "ctrl-q",
              "ctrl-r",
              "ctrl-s",
              "ctrl-t",
              "ctrl-u",
              "ctrl-v",
              "ctrl-w",
              "ctrl-x",
              "ctrl-y",
              "ctrl-z"
            ]
          }
        },
        "controller_handle": {
          "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/controller_handle"
        }
      }
    }
  ]
}
